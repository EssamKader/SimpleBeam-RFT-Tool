<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="image probe" Height="140" Width="220"
        ShowInTaskbar="False">
    <!-- The whole point of this file: a relative Source declared IN XAML.
         Loaded inside a try/except by the spike and never shown, so if
         wpf.LoadComponent throws on the unresolvable path, the failure is
         caught and reported instead of taking the main window down. -->
    <Image x:Name="declared_image" Source="probe.png" Stretch="None"/>
</Window>
