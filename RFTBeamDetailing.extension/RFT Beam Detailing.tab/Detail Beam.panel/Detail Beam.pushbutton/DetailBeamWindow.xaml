<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Detail Beam"
        Height="680" Width="880"
        MinHeight="520" MinWidth="640"
        WindowStartupLocation="CenterScreen"
        SizeToContent="Manual">

    <!-- #60: the palette, declared ONCE. Every colour in this window is a
         named brush from here, so the whole scheme changes in one place
         and nothing drifts. Two of them are deliberately NOT brand
         colours: a window where everything is sky blue cannot show
         alarm, so warnings stay amber and failures stay red. -->
    <Window.Resources>
        <SolidColorBrush x:Key="SurfaceWhite" Color="#FFFFFFFF"/>
        <!-- Very pale sky, for grounds that must recede: the inactive tab
             strip and (later, #51) the diagram backgrounds. -->
        <SolidColorBrush x:Key="SurfaceTint" Color="#FFF2F9FD"/>
        <SolidColorBrush x:Key="SurfaceDisabled" Color="#FFEDF1F3"/>

        <!-- Sky blue itself. The SELECTED tab takes this, which is the
             specific thing #60 asks for. It is light, so text on it is
             INK, not white - white on #87CEEB is unreadable at 12pt and
             would have been the obvious mistake. -->
        <SolidColorBrush x:Key="SkyBlue" Color="#FF87CEEB"/>
        <SolidColorBrush x:Key="SkyBlueHover" Color="#FFD6EEF9"/>
        <!-- The deeper tone carries section headings, where sky blue
             itself would be too faint against white to read as emphasis. -->
        <SolidColorBrush x:Key="SkyBlueDeep" Color="#FF1F6F94"/>
        <SolidColorBrush x:Key="BorderSubtle" Color="#FFC9DFEA"/>

        <SolidColorBrush x:Key="InkPrimary" Color="#FF1B2A33"/>
        <SolidColorBrush x:Key="InkMuted" Color="#FF5A6B75"/>
        <!-- Disabled must stay LEGIBLE, not vanish: the Crack bars tab is
             disabled until h > 700, so this state is on screen routinely
             rather than exceptionally. -->
        <SolidColorBrush x:Key="InkDisabled" Color="#FF8A9AA4"/>

        <SolidColorBrush x:Key="WarningAmber" Color="#FFB05A00"/>
        <SolidColorBrush x:Key="DangerRed" Color="#FFB00000"/>
        <!-- #49 (U5): the live sketch's ONLY "complies" colour. None of
             the ten brushes above is green, and the notation SVG
             (docs/ui/sketch-notation.svg) uses green specifically for a
             passing dimension and for crack/skin bars: see
             rft.ui.sketch_palette, which is the one place a style key is
             mapped to a brush NAME (never a WPF object) so the mapping
             itself is testable under plain CPython. -->
        <SolidColorBrush x:Key="PassGreen" Color="#FF2E7D32"/>

        <!-- The selected tab. WPF's default TabItem template paints its own
             selected background and IGNORES Background entirely, so this
             replaces the template rather than setting properties - the
             same reason pyRevit's own SettingsWindow.xaml templates a
             ToggleButton instead of styling one. -->
        <Style TargetType="{x:Type TabItem}">
            <Setter Property="Foreground" Value="{StaticResource InkMuted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabChrome"
                                Background="{StaticResource SurfaceTint}"
                                BorderBrush="{StaticResource BorderSubtle}"
                                BorderThickness="1,1,1,0"
                                Margin="0,0,2,0" Padding="14,7,14,7">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabChrome" Property="Background"
                                        Value="{StaticResource SkyBlue}"/>
                                <Setter Property="Foreground"
                                        Value="{StaticResource InkPrimary}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="False"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="TabChrome" Property="Background"
                                        Value="{StaticResource SkyBlueHover}"/>
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="TabChrome" Property="Background"
                                        Value="{StaticResource SurfaceDisabled}"/>
                                <Setter Property="Foreground"
                                        Value="{StaticResource InkDisabled}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Section headings. Keyed, not implicit: an implicit TextBlock
             style would also repaint the status and warning lines, which
             carry meaning through colour. -->
        <Style x:Key="SectionHeading" TargetType="{x:Type TextBlock}">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource SkyBlueDeep}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style TargetType="{x:Type TextBox}">
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}"/>
            <Setter Property="Foreground" Value="{StaticResource InkPrimary}"/>
            <Setter Property="Padding" Value="3,2,3,2"/>
        </Style>
    </Window.Resources>

    <!-- Shell (issue #46, U2): one WPFWindow, one TabControl, proven by the
         #42 spike. Every tab is now built: Beam & Materials (#47),
         Main bars / Stirrups / Crack bars (#48), Review (#50), and
         placement itself (#56). #60 gives it the palette. -->
    <!-- The window ground lives HERE, on the root Grid, not on the Window
         element. A Window's own attributes are resolved BEFORE its
         Window.Resources block is populated, so a StaticResource up there
         cannot see these brushes and throws "Cannot find resource named
         'SurfaceWhite'" at load. A child element is parsed after the
         resources and resolves fine. -->
    <Grid Margin="8" Background="{StaticResource SurfaceWhite}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Margin="2,0,2,8" TextWrapping="Wrap"
                   Text="Detail Beam -- one command, one transaction (A46/A47). Pick a beam on the Beam &amp; Materials tab first (A35): every geometry and support field stays disabled until you do."/>

        <TabControl x:Name="tabs" Grid.Row="1"
                    Background="{StaticResource SurfaceWhite}"
                    BorderBrush="{StaticResource BorderSubtle}">

            <TabItem Header="Beam &amp; Materials">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">

                        <!-- A35: the pick control sits at the TOP of this tab,
 and is the only thing enabled before a beam is picked. -->
                        <Button x:Name="pick_btn" Content="Pick beam..."
                                HorizontalAlignment="Left" Padding="14,4" Margin="0,0,0,6"/>
                        <TextBlock x:Name="beam_status_tb" FontWeight="Bold"
                                   Text="No beam picked yet." Margin="0,0,0,6" TextWrapping="Wrap"/>
                        <TextBlock x:Name="warnings_tb" Foreground="{StaticResource WarningAmber}"
                                   TextWrapping="Wrap" Margin="0,0,0,10" Text=""/>

                        <!-- Disabled as a whole group until a successful pick;
 re-picking repopulates every field below and
 re-runs support detection (A35). -->
                        <StackPanel x:Name="geometry_panel" IsEnabled="False">
                            <TextBlock Text="Geometry (read from the model)" Style="{StaticResource SectionHeading}" Margin="0,4,0,4" TextWrapping="Wrap"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="L (mm)" TextWrapping="Wrap"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="b (mm)" TextWrapping="Wrap"/>
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="h (mm)" TextWrapping="Wrap"/>
                                <TextBox x:Name="l_tb" Grid.Row="1" Grid.Column="0" Margin="0,2,6,0"/>
                                <TextBox x:Name="b_tb" Grid.Row="1" Grid.Column="1" Margin="0,2,6,0"/>
                                <TextBox x:Name="h_tb" Grid.Row="1" Grid.Column="2" Margin="0,2,0,0"/>
                            </Grid>

                            <!-- #47 (U3): the four covers, each face SEPARATELY, never
 concatenated into one TextBlock (this ticket's explicit
 requirement), and the two end covers are "n/a (supported)"
 rather than a number whenever that end is supported (never
 format None numerically: the rc5 crash). Side cover is a
 fifth read this module also exposes (section 6/7's horizontal
 dimensions) and is shown alongside for the same reason. -->
                            <TextBlock Text="Covers (read from the beam's own faces, per face)" Style="{StaticResource SectionHeading}" Margin="0,0,0,4" TextWrapping="Wrap"/>
                            <TextBlock x:Name="cover_top_tb" TextWrapping="Wrap" Margin="0,0,0,2" Text=""/>
                            <TextBlock x:Name="cover_bottom_tb" TextWrapping="Wrap" Margin="0,0,0,2" Text=""/>
                            <TextBlock x:Name="cover_side_tb" TextWrapping="Wrap" Margin="0,0,0,2" Text=""/>
                            <TextBlock x:Name="cover_start_end_tb" TextWrapping="Wrap" Margin="0,0,0,2" Text=""/>
                            <TextBlock x:Name="cover_end_end_tb" TextWrapping="Wrap" Margin="0,0,0,10" Text=""/>

                            <TextBlock Text="Support detection, per end" Style="{StaticResource SectionHeading}" Margin="0,0,0,4" TextWrapping="Wrap"/>
                            <TextBlock x:Name="start_support_tb" TextWrapping="Wrap" Margin="0,0,0,2" Text=""/>
                            <TextBlock x:Name="end_support_tb" TextWrapping="Wrap" Margin="0,0,0,10" Text=""/>

                            <!-- #47 (U3): one RebarBarType picker per bar role, plus the
 stirrup RebarHookType. Each ComboBox's ItemsSource is a
 plain list of label strings set from script.py (never the
 raw (label, element) tuples, which renders the Python repr
 in the dropdown), and NO item is pre-selected: A42 forbids a
 "first found" fallback, so the dropdown opens genuinely
 empty until the engineer picks. The label TextBlock above
 each combo carries A34's required grade
 (role_picker_label), set from script.py so the wording can
 never drift from rft.core.grades' own mapping. -->
                            <TextBlock Text="Bar types (one per role, A34/A42 -- no fallback to &quot;first found&quot;)" Style="{StaticResource SectionHeading}" Margin="0,0,0,4" TextWrapping="Wrap"/>

                            <TextBlock x:Name="top_main_bar_label_tb" TextWrapping="Wrap" Margin="0,4,0,2" Text=""/>
                            <ComboBox x:Name="top_main_bar_combo" Margin="0,0,0,6" HorizontalAlignment="Left" MinWidth="360"/>

                            <TextBlock x:Name="bottom_main_bar_label_tb" TextWrapping="Wrap" Margin="0,0,0,2" Text=""/>
                            <ComboBox x:Name="bottom_main_bar_combo" Margin="0,0,0,6" HorizontalAlignment="Left" MinWidth="360"/>

                            <TextBlock x:Name="stirrup_bar_label_tb" TextWrapping="Wrap" Margin="0,0,0,2" Text=""/>
                            <ComboBox x:Name="stirrup_bar_combo" Margin="0,0,0,6" HorizontalAlignment="Left" MinWidth="360"/>

                            <TextBlock x:Name="crack_bar_label_tb" TextWrapping="Wrap" Margin="0,0,0,2" Text=""/>
                            <ComboBox x:Name="crack_bar_combo" Margin="0,0,0,6" HorizontalAlignment="Left" MinWidth="360"/>

                            <!-- The hook has no A34 grade of its own (rev 2 section 7.3,
 A45): the label here is fixed, unlike the bar-role labels
 above which are set from rft.core.grades. The candidate list
 is already filtered to the Stirrup/Tie family
 (REBAR_HOOK_STYLE == 1) before this combo is even populated;
 the selection is re-checked again after picking (A45).
 stirrup_hook_status_tb reports if NO usable hook exists in
 the document at all. -->
                            <TextBlock Text="Stirrup hook (RebarHookType, Stirrup/Tie family, 135 deg +/- 1 deg -- A45):"
                                       TextWrapping="Wrap" Margin="0,0,0,2"/>
                            <ComboBox x:Name="stirrup_hook_combo" Margin="0,0,0,2" HorizontalAlignment="Left" MinWidth="360"/>
                            <TextBlock x:Name="stirrup_hook_status_tb" Foreground="{StaticResource DangerRed}"
                                       TextWrapping="Wrap" Margin="0,0,0,10" Text=""/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- #48 (U4): main-bar counts and layer counts SHIP BLANK (A44;
 #50/U6's derivation rule depends on this) - everything else
 on this tab ships with its A36 v1 default already in the
 TextBox. Nothing here is placed by this ticket; the Review
 tab's derivation and the placement port are #50/#56. -->
            <TabItem Header="Main bars">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,10"
                                   Text="Bar counts and layer counts per face SHIP BLANK (A44) -- the engineer states them, and the tool never re-splits what is entered. Everything else here ships with its rev 2 section 8.1/A36 default."/>

                        <TextBlock Text="Top face" Style="{StaticResource SectionHeading}" Margin="0,0,0,4" TextWrapping="Wrap"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Bars per layer, top face" TextWrapping="Wrap"/>
                            <TextBlock x:Name="top_layers_label_tb" Grid.Row="0" Grid.Column="1" Text="Number of top layers" TextWrapping="Wrap"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="How the top bars sit (section 6.3)" TextWrapping="Wrap"/>
                            <TextBox x:Name="top_bar_count_tb" ToolTip="Ships BLANK on purpose (A44): you state the count, and the tool never re-splits it. Leaving it blank means this face is not detailed." Grid.Row="1" Grid.Column="0" Margin="0,2,6,0" Text=""/>
                            <TextBox x:Name="top_layers_tb" Grid.Row="1" Grid.Column="1" Margin="0,2,6,0" Text=""/>
                            <ComboBox x:Name="top_face_option_combo" Grid.Row="1" Grid.Column="2" Margin="0,2,0,0"/>
                        </Grid>

                        <TextBlock Text="Bottom face" Style="{StaticResource SectionHeading}" Margin="0,0,0,4" TextWrapping="Wrap"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Bars per layer, bottom face" TextWrapping="Wrap"/>
                            <TextBlock x:Name="bottom_layers_label_tb" Grid.Row="0" Grid.Column="1" Text="Number of bottom layers" TextWrapping="Wrap"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="How the bottom bars sit (section 6.3)" TextWrapping="Wrap"/>
                            <TextBox x:Name="bottom_bar_count_tb" ToolTip="Ships BLANK on purpose (A44): you state the count, and the tool never re-splits it. Leaving it blank means this face is not detailed." Grid.Row="1" Grid.Column="0" Margin="0,2,6,0" Text=""/>
                            <TextBox x:Name="bottom_layers_tb" Grid.Row="1" Grid.Column="1" Margin="0,2,6,0" Text=""/>
                            <ComboBox x:Name="bottom_face_option_combo" Grid.Row="1" Grid.Column="2" Margin="0,2,0,0"/>
                        </Grid>

                        <TextBlock Text="Layout and anchorage" Style="{StaticResource SectionHeading}" Margin="0,4,0,4" TextWrapping="Wrap"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Clear gap between stacked layers (O_spacer, mm)" TextWrapping="Wrap"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="Largest aggregate size (D_agg, mm) -- leave blank and 50 mm governs" TextWrapping="Wrap"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Raise the minimum bar spacing (mm) -- blank lets the tool decide" TextWrapping="Wrap"/>
                            <TextBox x:Name="spacer_dia_tb" ToolTip="The CLEAR vertical gap between one layer and the next (rev 2 section 4.1). No spacer bar is placed by this tool -- the spec does not dimension one, and inventing it is prohibited." Grid.Row="1" Grid.Column="0" Margin="0,2,6,0" Text="16"/>
                            <TextBox x:Name="d_agg_tb" ToolTip="Minimum clear spacing = max(25 mm, bar diameter, 1.33 x D_agg) when you give D_agg. Leave it BLANK and a flat 50 mm governs instead (rev 2 section 6.2). Blank is the shipped default." Grid.Row="1" Grid.Column="1" Margin="0,2,6,0" Text=""/>
                            <TextBox x:Name="min_spacing_override_tb" ToolTip="A FLOOR ONLY (A29): governing spacing = max(computed minimum, your value). It can make spacing stricter, never looser -- a value below the computed minimum is ignored entirely." Grid.Row="1" Grid.Column="2" Margin="0,2,0,0" Text=""/>
                        </Grid>

                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="ld_top_label_tb" Grid.Row="0" Grid.Column="0" Text="Top bar development length multiplier (LD_top)" TextWrapping="Wrap"/>
                            <TextBlock x:Name="ld_btm_label_tb" Grid.Row="0" Grid.Column="1" Text="Bottom bar development length multiplier (LD_btm)" TextWrapping="Wrap"/>
                            <TextBox x:Name="ld_top_mult_tb" Grid.Row="1" Grid.Column="0" Margin="0,2,6,0" Text=""/>
                            <TextBox x:Name="ld_btm_mult_tb" Grid.Row="1" Grid.Column="1" Margin="0,2,0,0" Text=""/>
                        </Grid>

                        <!-- #49 (U5): the LIVE cross-section sketch, replacing #51's
 static teaching diagram (that diagram's own comment said "Real
 numbers belong to #49's live sketch"). Every shape on this
 Canvas is drawn by script.py's renderer from a plain list of
 rft.ui.sketch namedtuples, no arithmetic in script.py itself
 (A48). ClipToBounds so a beam wider than the pane never spills
 past the Border; SizeChanged triggers a rescale, not a
 recompute (the numbers do not change, only cx/cy/s do). -->
                        <Border Margin="0,14,0,0" Padding="10" Background="{StaticResource SurfaceTint}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" HorizontalAlignment="Stretch">
                            <StackPanel>
                                <Canvas x:Name="main_bars_sketch_canvas" Height="260" ClipToBounds="True" Background="{StaticResource SurfaceWhite}"/>
                                <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource InkMuted}" Text="Live cross-section: every dimension comes from rft.core (A48). Stirrup stations and hook fillets elsewhere in this tool are schematic; this section view has neither, see the Stirrups tab."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- #48 (U4): closure type is a ComboBox of 1/2/4 ONLY - type 3
 is never an item to select, not merely refused after typing
 (A31, R6, this ticket's fourth specified constraint). The
 note TextBlock below shows
 rft.core.guards.stirrup_type3_guard_message()'s OWN text,
 set from script.py, so the wording cannot drift from the
 guard it quotes. -->
            <TabItem Header="Stirrups">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                    <TextBlock Text="Spacing" Style="{StaticResource SectionHeading}" Margin="0,0,0,4" TextWrapping="Wrap"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Stirrup spacing near the supports (mm)" TextWrapping="Wrap"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="Stirrup spacing at midspan (mm)" TextWrapping="Wrap"/>
                        <TextBox x:Name="dense_spacing_tb" Grid.Row="1" Grid.Column="0" Margin="0,2,6,0" Text="150"/>
                        <TextBox x:Name="normal_spacing_tb" Grid.Row="1" Grid.Column="1" Margin="0,2,0,0" Text="200"/>
                    </Grid>

                    <TextBlock Text="Closure type (section 7.2)" Style="{StaticResource SectionHeading}" Margin="0,0,0,4" TextWrapping="Wrap"/>
                    <ComboBox x:Name="closure_type_combo" HorizontalAlignment="Left" MinWidth="120" Margin="0,0,0,4"/>
                    <TextBlock x:Name="closure_type3_note_tb" Foreground="{StaticResource WarningAmber}"
                               TextWrapping="Wrap" Margin="0,0,0,0" Text=""/>

                        <!-- #49 (U5): the LIVE longitudinal elevation, replacing #51's
 static teaching diagram, shown while THIS tab is active (A47).
 Individual stirrup stations are drawn SCHEMATIC (evenly spaced
 ticks, style "schematic"): the count and spacing are exact
 (rft.core.plan.StirrupPlan), the STATIONS are Revit's rebar
 set's own layout and are never predicted here (A48/A49). -->
                        <Border Margin="0,14,0,0" Padding="10" Background="{StaticResource SurfaceTint}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" HorizontalAlignment="Stretch">
                            <StackPanel>
                                <Canvas x:Name="stirrups_sketch_canvas" Height="220" ClipToBounds="True" Background="{StaticResource SurfaceWhite}"/>
                                <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource InkMuted}" Text="Live elevation: zone boundaries, counts and spacing are exact (rft.core); individual stirrup stations and hook bend arcs are drawn schematic, labelled so on the drawing, because Revit's own rebar set and bar type own that geometry (A48/A49)."/>
                            </StackPanel>
                        </Border>
                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- #48 (U4): the whole tab is enabled only when
 crack_bars.crack_reinforcement_triggered(h) - strict
 h &gt; 700 (section 5) - re-evaluated on every edit of h,
 never only at pick time (h is editable, #47/A35). H_avail is
 DISPLAYED, never entered (this ticket's third specified
 constraint): the sharpest gap in v0.1.0 was
 "Place Crack Bars" re-asking for layer counts and reading
 nothing back, so H_avail could silently disagree with the
 as-built beam. -->
            <TabItem x:Name="crack_bars_tab" Header="Crack bars" IsEnabled="False">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,10"
                               Text="Enabled only when h &gt; 700 mm (rev 2 section 5, strict). O_crack comes from the crack RebarBarType picker on Beam &amp; Materials -- no diameter is re-asked here."/>
                    <TextBlock x:Name="crack_s_max_label_tb" Text="Max spacing between crack-bar layers, s_max (mm)" TextWrapping="Wrap"/>
                    <TextBox x:Name="crack_s_max_tb" HorizontalAlignment="Left" MinWidth="120" Margin="0,2,0,10" Text=""/>

                    <TextBlock Text="H_avail (rev 2 section 5.1, A26 -- innermost main-bar layer, read from the Main bars tab)" Style="{StaticResource SectionHeading}" Margin="0,0,0,2" TextWrapping="Wrap"/>
                    <TextBlock x:Name="h_avail_tb" TextWrapping="Wrap" Text=""/>

                        <!-- #49 (U5): the LIVE cross-section sketch (A47: section while
 this tab is active, same as Main bars), replacing #51's static
 teaching diagram. Crack bars, H_avail and both faces' innermost
 layer are all drawn to scale from the same CrackPlan/LayerPlan
 objects the Review report and the placer use (A48/#56). -->
                        <Border Margin="0,14,0,0" Padding="10" Background="{StaticResource SurfaceTint}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" HorizontalAlignment="Stretch">
                            <StackPanel>
                                <Canvas x:Name="crack_bars_sketch_canvas" Height="260" ClipToBounds="True" Background="{StaticResource SurfaceWhite}"/>
                                <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource InkMuted}" Text="H_avail is measured between the innermost main-bar layers, not between the concrete faces (A26) -- both faces need a bar type and a layer count before crack bars, or this drawing, can show anything here."/>
                            </StackPanel>
                        </Border>
                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- #50 (U6): the derivation rule (rev 2 section 8, A47/A50)
 states, per section, whether it will be placed and WHY when it
 will not: review_derivation_tb, updated live (no Revit call,
 since a bar/hook type is only ever tested "is this None"), never
 only at Place time. Place itself is disabled whenever nothing at
 all is requested (this ticket's brief); its IsEnabled is owned
 by script.py's _refresh_review_derivation, not a static XAML
 default, so there is exactly one place that decision is made.
 The full section 8.2/A37 report reads bar type names/diameters
 and re-detects supports, genuine Revit API calls, so it sits
 behind its own "Build full report" button, dispatched (#57)
 rather than recomputed on every keystroke. A copy is also
 written to the pyRevit output window (A37). Placement itself
 stays #56's scope: pressing Place opens ONE Transaction (A46),
 calls into _do_place, and rolls back entirely on any exception,
 guaranteed right now, since placement is still a stub. -->
            <TabItem Header="Review">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" FontWeight="Bold" TextWrapping="Wrap"
                               Text="Review -- derived placement list (rev 2 section 8, A47/A50)"/>
                    <TextBlock x:Name="review_derivation_tb" Grid.Row="1" TextWrapping="Wrap"
                               Margin="0,6,0,10" Text=""/>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button x:Name="build_report_btn" Content="Build full report"
                                Padding="14,4" Margin="0,0,10,0"/>
                        <Button x:Name="place_btn" Content="Place" Padding="18,4"/>
                    </StackPanel>

                    <TextBox x:Name="review_report_tb" Grid.Row="3" IsReadOnly="True"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             TextWrapping="NoWrap" AcceptsReturn="True" FontFamily="Consolas"
                             Background="#FFF5F5F5" Text=""/>

                    <TextBlock x:Name="place_result_tb" Grid.Row="4" TextWrapping="Wrap"
                               Margin="0,10,0,0" Foreground="{StaticResource DangerRed}" Text=""/>
                </Grid>
            </TabItem>
        </TabControl>

        <TextBlock x:Name="status_tb" Grid.Row="2" Margin="2,8,2,0"
                   FontFamily="Consolas" Text="ready" TextWrapping="Wrap"/>
    </Grid>
</Window>
